# Copy to .env and fill in. Never commit .env.

# Backend (engine/)
ANTHROPIC_API_KEY=
PACT_CLAUDE_MODEL=claude-haiku-4-5-20251001
DATABASE_URL=sqlite:///./pact.db
FRONTEND_ORIGIN=http://localhost:3000
# For a LAN preview, add the exact frontend origin, comma separated, e.g. http://192.168.1.20:3000
DEMO_CACHE=false
BANK_PROVIDER=synthetic
# Login codes by email (any SMTP provider). Port 465 uses SSL, anything else STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Pact <you@example.com>
# Local testing only: without SMTP, show the code in the app and the engine log. Never in production.
PACT_DEV_CODES=false
# Keeps login codes valid across engine restarts. Any long random string.
PACT_SECRET=
# Passkeys (Face ID / Touch ID / Windows Hello): the site's host name, no port.
PACT_RP_ID=localhost
# Keep true for HTTPS or localhost. Set false only for local HTTP/LAN testing.
PACT_COOKIE_SECURE=true

# Frontend (web/)
NEXT_PUBLIC_API_URL=http://localhost:8000
USE_MOCKS=true
CAPTURE=false

# Read-aloud voice (ElevenLabs). Server-side only: never put this in a NEXT_PUBLIC_ variable.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v4
ELEVENLABS_VOICE_ID=Xb7hH8MSUJpSbSDYk0k2
# Character budgets, kept under the plan's quota (free tier: 10,000 a month). Over budget, the browser voice reads instead.
ELEVENLABS_DAILY_CHARS=3000
ELEVENLABS_MONTHLY_CHARS=9000
